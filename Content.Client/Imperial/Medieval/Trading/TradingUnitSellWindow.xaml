<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc trading-ui-unit-sell-window-title}"
    MinSize="460 150">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="Prompt" HorizontalExpand="True" MinWidth="430" />
        <SliderIntInput Name="AmountSlider" HorizontalExpand="True" Margin="0 10 0 0" />
        <Button Name="ConfirmButton" Text="{Loc trading-ui-unit-sell-confirm-button}" HorizontalAlignment="Center" MinWidth="160" Margin="0 10 0 0" />
    </BoxContainer>
</DefaultWindow>

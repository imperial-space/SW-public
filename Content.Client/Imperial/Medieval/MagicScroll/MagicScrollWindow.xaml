<!-- MagicScrollWindow.xaml -->
<!-- ===================================================================== -->
<!-- Purpose: XAML layout for magic scroll decryption window -->
<!-- Author: rhailrake, edited by Bladefire5 -->
<!-- ===================================================================== -->

<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
               Title="{Loc 'magic-scroll-window-title'}"
               MinSize="400 300"
               MaxSize="500 400">
    <BoxContainer Orientation="Vertical" Margin="10">
        <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
            <Label Name="PowerLabel" Text="{Loc 'magic-scroll-power-placeholder'}" HorizontalAlignment="Center"/>
            <Label Name="StatusLabel" Text="{Loc 'magic-scroll-status-not-deciphered'}" HorizontalAlignment="Center"/>
        </BoxContainer>

        <customControls:HSeparator Margin="0 10"/>

        <BoxContainer Orientation="Vertical">
            <Label Text="{Loc 'magic-scroll-encrypted-runes'}" Margin="0 0 0 5"/>
            <GridContainer Name="EncryptedRunesGrid" Columns="8" HorizontalExpand="True" HSeparationOverride="5" VSeparationOverride="5">
            </GridContainer>
        </BoxContainer>

        <customControls:HSeparator Margin="0 10"/>

        <BoxContainer Orientation="Vertical" VerticalExpand="True">
            <Label Text="{Loc 'magic-scroll-known-runes-pairs'}" Margin="0 0 0 5"/>
            <ScrollContainer VerticalExpand="True" MinSize="0 110">
                <GridContainer Name="KnownRunesGrid" Columns="3" HorizontalExpand="True" HSeparationOverride="5" VSeparationOverride="5">
                </GridContainer>
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>

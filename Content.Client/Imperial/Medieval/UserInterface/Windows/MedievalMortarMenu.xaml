<ui:MedievalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.Imperial.Medieval.UserInterface.Windows.MedievalMortarMenu"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.Imperial.Medieval.CapturePoint.UI.MedievalWindow"
    xmlns:style="clr-namespace:Content.Client.Imperial.Medieval.UserInterface.Elements"
    Title="{Loc 'medieval-mortar-menu-title'}"
    Resizable="False">
    <!-- fixed width: names changing length must not resize the window -->
    <BoxContainer Orientation="Vertical" SetWidth="336">
        <!-- what's in the mortar, on one shelf; click one to take it out -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="{x:Static style:MedievalUiStyle.Inset}" />
            </PanelContainer.PanelOverride>
            <BoxContainer Name="SlotsBox" Orientation="Horizontal" />
        </PanelContainer>

        <!-- the mortar itself, straight on the window; sparkles around it while the pestle works -->
        <LayoutContainer Name="SceneLayout" Margin="0 4 0 0" />

        <Label Name="StatusLabel" Align="Center" ClipText="True" Margin="0 4 0 8" />

        <BoxContainer Orientation="Horizontal">
            <ui:MedievalButton
                Name="GrindButton"
                Text="{Loc 'medieval-mortar-menu-grind'}"
                HorizontalExpand="True"
                TextAlign="Center" />
            <ui:MedievalButton
                Name="JuiceButton"
                Text="{Loc 'medieval-mortar-menu-juice'}"
                HorizontalExpand="True"
                TextAlign="Center" />
        </BoxContainer>

        <controls:HLine Color="{x:Static style:MedievalUiStyle.Border}" Thickness="1" Margin="0 10 0 4" />

        <!-- the vessel the mortar pours into; filled from code -->
        <BoxContainer Name="VesselBox" Orientation="Vertical" />
    </BoxContainer>
</ui:MedievalWindow>

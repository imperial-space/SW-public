<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="340 260">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="12" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="8" MinWidth="300" HorizontalExpand="True">
                <Label Text="{Loc 'alchemy-ui-input'}" />
                <Button Name="InsertInput" Access="Public" Text="{Loc 'alchemy-ui-insert-input'}" />
                <PanelContainer MinHeight="130" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ItemList Name="InputItems" Access="Public" SelectMode="Button" Margin="5" ItemSeparation="5" />
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Name="OutputSection" Access="Public" Orientation="Vertical" SeparationOverride="8" MinWidth="300" HorizontalExpand="True">
                <Label Name="OutputLabel" Access="Public" />
                <Button Name="InsertOutput" Access="Public" Text="{Loc 'alchemy-ui-insert-output'}" />
                <PanelContainer MinHeight="130" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ItemList Name="OutputItems" Access="Public" SelectMode="Button" Margin="5" ItemSeparation="5" />
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <Button Name="Start" Access="Public" Text="{Loc 'alchemy-ui-start'}" />
    </BoxContainer>
</controls:FancyWindow>

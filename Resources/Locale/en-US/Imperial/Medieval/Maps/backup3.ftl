    {"- x2 pea pod"}

    {"- x10u water"}

    {"10 seconds"}

    {"Tomato soup:"}

    {"- x1 bowl"}

    {"- x2 tomato"}

    {"- x10u water"}

    {"Meatball soup:"}

    {"- x1 bowl"}


ent-MedievalElementalFire = fire elemental
    .desc = The wrath of the element of fire. Much easier to kill if frozen.
    .suffix = { "Medieval, mob" }

ent-MedievalElementalAir = air elemental
    .desc = The wrath of the forces of light. It can only be slain by a blade.
    .suffix = { "Medieval, mob" }

ent-MedievalElementalEarth = earth elemental
    .desc = The wrath of the earth. It is immune to your attacks; only magic can kill it.
    .suffix = { "Medieval, mob" }

ent-MedievalElementalWater = water elemental
    .desc = The wrath of the element of water. Much easier to kill if set aflame.
    .suffix = { "Medieval, mob" }


ent-MedievalMobSkeletWeak = weak skeleton
    .desc = A bundle of brittle bones held together by a weak curse. One solid blow should send it clattering apart.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletMeat = meat skeleton
    .desc = Old flesh still hangs from the bones, making it tougher and nastier than the weakest kind.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletFighter = warrior skeleton
    .desc = This skeleton still remembers how to fight. You can take it in a fair duel, but not if you get sloppy.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletLegion = legionary skeleton
    .desc = A dead legionary with a hard swing and the stubborn discipline of its old formation. It takes real effort to put down.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletArcher = archer skeleton
    .desc = A fragile skeleton with an old bow. Up close it will not last long, but leave it at a distance and the arrows will keep coming.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletDark = cursed skeleton
    .desc = Death did not pass over these bones. It settled inside them.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletCrossbow = skeleton crossbowman
    .desc = It shambles under the weight of its crossbow, but the bolt does not. Close the distance before it lines up a shot.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletWeakGhost = weak skeleton
    .desc = A bundle of brittle bones held together by a weak curse. One solid blow should send it clattering apart.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletWeakGhostResp = dead player
    .desc = Ancient bones pulled upright by a restless curse. They barely hold together, but they still answer the call.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletMeatGhost = meat skeleton
    .desc = Old flesh still hangs from the bones, making it tougher and nastier than the weakest kind.
    .suffix = { "Medieval, mob, ghost role" }

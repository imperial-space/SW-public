    .desc = A dead legionary with a hard swing and the stubborn discipline of its old formation. It takes real effort to put down.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletMace = skeleton with mace and shield
    .desc = A sturdy skeleton with a battered shield and a mace heavy enough to make every mistake hurt.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletMaceGhost = skeleton with mace and shield
    .desc = A sturdy skeleton with a battered shield and a mace heavy enough to make every mistake hurt.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletSpear = skeleton with spear
    .desc = The spear gives this one more reach than you might like. Keep your guard up before stepping in.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletSpearGhost = skeleton with spear
    .desc = The spear gives this one more reach than you might like. Keep your guard up before stepping in.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletHalberd = skeleton with halberd
    .desc = The halberd is slow to swing, but it bites hard when it lands. Bad timing will cost blood.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletHalberdGhost = skeleton with halberd
    .desc = The halberd is slow to swing, but it bites hard when it lands. Bad timing will cost blood.
    .suffix = { "Medieval, mob, ghost role" }
ent-MedievalMobSkeletDagger = skeleton with daggers
    .desc = Fast on its feet and armed for close work. Keep it away, or the cuts will come faster than you expect.
    .suffix = { "Medieval, mob" }
ent-MedievalMobSkeletDaggerGhost = skeleton with daggers
    .desc = Fast on its feet and armed for close work. Keep it away, or the cuts will come faster than you expect.
    .suffix = { "Medieval, mob, ghost role" }


ghost-role-information-skelet-rules = You are a skeleton. Let frail flesh fall. Glory to necromancers and dark mages!
ghost-role-information-skelet-weak-name = Weak skeleton
ghost-role-information-skelet-weak-description = The lowest of the risen dead, more rattle than wrath.
ghost-role-information-skelet-meat-name = Meat skeleton
ghost-role-information-skelet-meat-description = Scraps of stubborn flesh cling to its bones like crude armor.
ghost-role-information-skelet-fighter-name = Warrior skeleton
ghost-role-information-skelet-fighter-description = Some fool armed the dead, and the dead remembered.
ghost-role-information-skelet-legion-name = Legionary skeleton
ghost-role-information-skelet-legion-description = A fallen legionary risen from the grave, marching now against the living.
ghost-role-information-skelet-archer-name = Archer skeleton
ghost-role-information-skelet-archer-description = A bow-bearing corpse whose arrows still remember the heart.
ghost-role-information-skelet-mace-name = Skeleton with mace and shield
ghost-role-information-skelet-mace-description = A sturdy dead fighter with a battered shield and a mace heavy enough to make mistakes hurt.
ghost-role-information-skelet-spear-name = Skeleton with spear
ghost-role-information-skelet-spear-description = Long reach, sharp point, and enough patience to punish a careless approach.
ghost-role-information-skelet-halberd-name = Skeleton with halberd
ghost-role-information-skelet-halberd-description = A dead soldier with a halberd that strikes rarely, but bites deep.
ghost-role-information-skelet-dagger-name = Skeleton with daggers
ghost-role-information-skelet-dagger-description = Fast on its feet, short on reach, and very fond of knives.

ent-MedievalMobSkeletWeakSpell = frail skeleton
    .desc = Arcane force keeps these poor bones standing. The spell is weak, and one good hit should break its hold.

ent-MedievalMobSkeletMeatSpell = fleshy skeleton
    .desc = Arcane power holds the old flesh in place. It is still poorly bound, but harder to put down than the frail kind.

ghost-role-information-skelet-hightier-rules = You are a skeleton. Let frail flesh fall. Glory to necromancers and warlocks. [color=red]You are forbidden to leave the place where you rose[/color]

ent-MedievalMobSkeletFighterSpell = skeleton warrior
    .desc = Sorcery put a fighter's memory back into these bones. It handles itself better than a corpse should.

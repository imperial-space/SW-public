ent-MedievalSteeringMapt0 = map table "Fish Eye"
    .desc = A ragged cloth instead of a map. It shows no more than one might see in a bucket of rainwater.

ent-MedievalSteeringMapt1 = map table "Guide"
    .desc = A salt-blackened table with a cracked top. The map barely outlines the nearest rocks and nothing more.

ent-MedievalSteeringMapt2 = map table "Seagull"
    .desc = A sturdy table of darkened ash, its corners worn down by the waves. The map shows the whole bay, and even a little of the open sea. The bare minimum for voyages.

ent-MedievalSteeringMapt4 = map table "Pathfinder"
    .desc = A bog-oak table inlaid with silver thread. The map rests neatly beneath glass, with instruments for comfortable navigation beside it.

ent-MedievalSteeringMapt5 = map table "Eye"
    .desc = They say this table can see every ship that puts out to sea. A globe and several magical artifacts are built into the tabletop to enhance its power.

